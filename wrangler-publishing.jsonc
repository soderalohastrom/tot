{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "palapala-publisher",
	"main": "./worker-publishing/src/index.ts",
	"workers_dev": true,
	"preview_urls": false,
	"compatibility_date": "2026-07-12",
	"compatibility_flags": ["nodejs_compat"],

	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	},

	"vars": {
		"WORKER_NAME": "palapala-publisher",
		"WORKER_VERSION": "0.1.0"
	},

	"routes": [
		{
			"pattern": "docs.palapala.me",
			"custom_domain": true
		}
	],

	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "palapala-pages"
		}
	],

	"d1_databases": [
		{
			"binding": "D1",
			"database_name": "palapala-registry",
			"database_id": "d8da1ac5-2902-442c-861f-bdf192df929c"
		}
	],

	"secrets": {
		"required": []
	}
}
